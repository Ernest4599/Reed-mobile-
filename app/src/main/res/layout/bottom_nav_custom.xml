<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/reed_bg"
    android:layout_gravity="bottom"
    android:paddingTop="8dp">

    <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_home"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Home" android:textColor="@color/reed_text" android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/navReel" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_reel"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reel" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/navRai" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="R∧I" android:textColor="#888888" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RAI" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/navMessage" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_message"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Message" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_profile"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Profile" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

</LinearLayout>
